# Copy to .env.local for `pnpm dev`. NEXT_PUBLIC_* values are baked in at build time.

# Genesis API gateway, as browsers reach it
NEXT_PUBLIC_API_URL=http://localhost:11000/api
# Optional: the gateway as the Next.js server reaches it, if different (e.g. http://api-gateway:11000/api in Docker)
API_INTERNAL_URL=

# Google Maps for delivery addresses (address suggestions, "pin on map", reverse geocoding).
# Enable Maps JavaScript API, Geocoding API and Places API (New) for this key and restrict it
# to your storefront's domains. Without it, shoppers can still share their GPS pin.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID for the pin map (Google Cloud → Map Management). DEMO_MAP_ID works for development.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Cloudinary unsigned upload preset for return photos (optional; photo upload is hidden without it)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
